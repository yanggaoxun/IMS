{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "mcp": {
    "mysql": {
      "type": "local",
      "command": [
        "node",
        "/opt/homebrew/lib/node_modules/@lanyuey/dbsql-mcp/dist/index.js"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": true
    }
  }
}
